# 复制成 .env 后填。所有值都有合理默认，最少只需要 ADMIN_PASSWORD_HASH。

# ─── 注册开关 ────────────────────────────────────────────────────
# 默认 false（关闭）。注册即拿到抖音号槽位和完整 API 权限，面板暴露到公网时
# 陌生人注册完就能用你的服务器和 IP 打抖音接口 —— 风控算在你头上。
# 自己一个人用就保持 false，用管理员账号登录即可。
ALLOW_REGISTER=false

# ─── 管理员（首次启动时 upsert，永久有效）────────────────────────
# 生成 hash：python -m app.cli hash-password <你的密码>
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# ─── 签名 ────────────────────────────────────────────────────────
# 生成：python -m app.cli gen-secret
SECRET_KEY=
SESSION_MAX_AGE=2592000        # 30 天
COOKIE_SECURE=false            # 生产 https 环境设 true

# ─── 数据 ────────────────────────────────────────────────────────
DATA_DIR=./data
DB_URL=                        # 留空自动用 sqlite:///./data/app.db
SITE_NAME=续火花
# Docker 数据卷挂载点（docker-compose 用），备份此目录即备份全部
# DATA_VOLUME_PATH=./data

# ─── 敏感字段加密 ────────────────────────────────────────────────
# 留空则 SMTP 密码等敏感字段以明文入库（启动会告警）。
# CRYPT_STRICT=1 时无密钥直接拒绝保存，生产建议开启。
CRYPT_STRICT=

# ─── 邮件通知（可选，也可在 /admin/smtp 后台配）─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                     # 留空则用 SMTP_USER
SMTP_TLS=true                  # 587 用 STARTTLS；465 需自行改 SSL

# ─── 抖音签名基建（ddocr + node）─────────────────────────────────
# 自建 ddddocr 滑块识别服务地址（仅短信登录需要）。留空则短信登录滑块不可用。
# 例：https://ocr.example.com （端点见下，鉴权走 X-API-Key）
DOUYIN_CAPTCHA_URL=
DOUYIN_CAPTCHA_ENDPOINT=/slide_match
DOUYIN_CAPTCHA_KEY=
DOUYIN_NODE_BIN=               # 留空自动查找 `node`
