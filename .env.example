# ─── 管理员（首次启动时 upsert，永久有效）────────────────────────
# 生成 hash：python -m app.cli hash-password <你的密码>
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# ─── 签名 ────────────────────────────────────────────────────────
# 生成：python -m app.cli gen-secret
SECRET_KEY=
SESSION_MAX_AGE=2592000        # 30 天
COOKIE_SECURE=false            # 生产 https 环境设 true

# ─── 数据 ────────────────────────────────────────────────────────
DATA_DIR=./data
DB_URL=                        # 留空自动用 sqlite:///./data/app.db
SITE_NAME=续火花

# ─── 抖音签名基建（ddocr + node）─────────────────────────────────
# 自建 ddddocr 滑块识别服务地址（仅短信登录需要）。留空则短信登录滑块不可用。
# 例：https://ocr.mrsong.top （端点 /slide/match，鉴权走 X-API-Key）
DOUYIN_CAPTCHA_URL=
DOUYIN_CAPTCHA_ENDPOINT=/slide/match
DOUYIN_CAPTCHA_KEY=
DOUYIN_NODE_BIN=               # 留空自动查找 `node`
