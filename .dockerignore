# 数据 / 敏感
data/
.env
.env.local
*.secret_key
# 任何私钥都不该进构建上下文（`build: .` 会把整个目录发给 daemon）
*.pem

# 辅助脚本，不进镜像
tools/

# 版本控制 & IDE
.git/
.gitignore
.github/
.claude/
.vscode/
.idea/
*.swp
.DS_Store

# 构建产物
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo

# Node modules（运行时用系统 node，不用项目自带）
node_modules/

# Playwright 旧 cache（Dockerfile 会重新装）
.cache/

# 测试 / 文档
test_*.py
README.md
docs/
*.md
!CLAUDE.md

# 临时文件
*.log
/tmp/
